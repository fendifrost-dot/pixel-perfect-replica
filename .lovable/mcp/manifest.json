{
  "version": 1,
  "sdk_version": "3.2.2",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "frost-sampler",
      "version": "1.0.0",
      "title": "Frost Sampler"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List shared projects",
        "description": "List intentionally public cloud projects; does not access device-only projects or private audio.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 25,
              "description": "Maximum projects to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "description": "Number of projects to skip for pagination.",
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Read shared project",
        "description": "Read one intentionally public cloud project by ID; private audio files are not accessible.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Shared cloud project ID from list_projects."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
